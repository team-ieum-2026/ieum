# ai/.env 로 복사해서 사용
# Gemini API 키 (디스코드 비공개 채널에서 받기)
GEMINI_API_KEY=
# LLM: gemini-3.8-flash (10/29 모델 비교로 결정, ai/eval/model_compare/RESULTS.md)
# AI-B: 추후 성능이 좋지 않다면 변경
LLM_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# AI-A: 서류 생성 전용 (사람 평가로 결정). 비우면 LLM_MODEL 을 쓴다
DOCUMENT_LLM_MODEL=gemini-4-argon