# backend/.env 로 복사해서 사용 (application.yml이 이 파일을 읽음)
DB_URL=jdbc:mysql://localhost:3306/ieum?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
# ieum DB에만 권한이 있는 전용 계정 (만드는 방법은 README "1. DB"). root 는 쓰지 않는다
DB_USERNAME=ieum
DB_PASSWORD=
AI_SERVER_URL=http://localhost:8000
# true면 AI 서버를 부르지 않고 고정 응답 사용 (AI 서버 준비 전)
AI_MOCK=true
# 서울 열린데이터광장 인증키 (디스코드 비공개 채널에서 받기)
SEOUL_OPENAPI_KEY=
FRONTEND_ORIGIN=http://localhost:3000
